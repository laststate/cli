{
  "name": "laststate-cli",
  "version": "1.0.0",
  "description": "LastState CLI for embedded crash reporting — Latch → LEP → Relay → Trace",
  "bin": {
    "laststate": "./dist/index.js",
    "ls": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "keywords": ["embedded", "crash-reporting", "latch", "laststate"],
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "conf": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "vitest": "^3.2.4",
    "vite": "^6.3.5"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
