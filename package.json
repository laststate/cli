{
  "name": "laststate-cli",
  "version": "1.2.0",
  "description": "LastState CLI for embedded crash reporting — Latch → LEP → Relay → Trace",
  "bin": {
    "laststate": "dist/index.js",
    "ls": "dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laststate/cli.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node -e \"const{cpSync,mkdirSync}=require('node:fs');mkdirSync('dist/assets',{recursive:true});cpSync('assets/brand.svg','dist/assets/brand.svg');cpSync('assets/brand.png','dist/assets/brand.png')\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "embedded",
    "crash-reporting",
    "latch",
    "laststate"
  ],
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^11.0.7",
    "execa": "^9.6.1",
    "get-port": "^7.2.0",
    "listr2": "^9.0.0",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/boxen": "^3.0.5",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
